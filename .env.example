# Base de datos (coincide con docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=pos_user
DB_PASSWORD=pos_password
DB_NAME=pos_db

# App
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:4200

# JWT
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=12h
JWT_CLIENTE_SECRET=cambia-esto-en-produccion-cliente
JWT_CLIENTE_EXPIRES_IN=30d

# Seed del primer SUPER_ADMIN (npm run seed)
SEED_SUPER_ADMIN_EMAIL=admin@pos-system.local
SEED_SUPER_ADMIN_PASSWORD=cambia-esta-clave

# Cifrado de credenciales sensibles (AES-256-GCM)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANTE: No commitear este valor. Generar uno nuevo en cada ambiente.
CIFRADO_CLAVE_MAESTRA=

# Correo transaccional (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="AURA <noreply@somosaura.dev>"

# URL pública del frontend — se usa para armar links de verificación de correo, etc.
FRONTEND_URL=https://app.somosaura.dev

# Wompi de la PLATAFORMA (cobrar a los negocios por su suscripción) — distinto
# de las credenciales por negocio que ya existen para que cada negocio cobre
# a SUS clientes (ver pos-backend/src/pagos/).
WOMPI_PLATAFORMA_LLAVE_PUBLICA=
WOMPI_PLATAFORMA_LLAVE_PRIVADA=
WOMPI_PLATAFORMA_LLAVE_INTEGRIDAD=
WOMPI_PLATAFORMA_LLAVE_SECRETA_EVENTOS=

# Alegra — Proveedor Tecnológico DIAN (e-provider), token de RESELLER (pool
# compartido entre todos los negocios-cliente, no uno por negocio — ver
# docs/ARQUITECTURA-V2.md sección 4). El token de sandbox probablemente NO
# sirve contra producción (no confirmado — no se probó con un token real de
# producción).
ALEGRA_RESELLER_TOKEN=
ALEGRA_BASE_URL_SANDBOX=https://sandbox-api.alegra.com/e-provider/col/v1
ALEGRA_BASE_URL_PRODUCCION=https://api.alegra.com/e-provider/col/v1
